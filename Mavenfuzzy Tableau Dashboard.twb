      <aliases enabled='yes' />
      <column caption='Avg Order Value' datatype='real' name='[Calculation_1554093743935619074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([price_usd (order_items.csv)])/COUNTD([order_id (order_item_refunds.csv)])' />
      </column>
      <column caption='Refund Rate' datatype='real' name='[Calculation_1554093743936135171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD([order_id (order_item_refunds.csv)])/COUNTD([order_id (order_items.csv)]))' />
      </column>
      <column caption='Running_Sum' datatype='real' name='[Calculation_1554093743939362820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM(price_usd))'>
          <table-calc ordering-type='Rows' />
        </calculation>
